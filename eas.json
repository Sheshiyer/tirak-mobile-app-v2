{
  "cli": {
    "version": ">= 16.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "bun": "1.3.5",
      "environment": "development",
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_REVIEW_MODE": "false",
        "EXPO_PUBLIC_PROMPTPAY_ENABLED": "false"
      },
      "ios": {
        "image": "latest"
      }
    },
    "preview": {
      "bun": "1.3.5",
      "environment": "preview",
      "channel": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_REVIEW_MODE": "false",
        "EXPO_PUBLIC_PROMPTPAY_ENABLED": "false"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "image": "latest"
      }
    },
    "core-qa": {
      "bun": "1.3.5",
      "environment": "preview",
      "channel": "core-qa",
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://tirak-core-qa-20261005.tirak-court.workers.dev/api",
        "EXPO_PUBLIC_ENV_NAME": "core-qa",
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_REVIEW_MODE": "false",
        "EXPO_PUBLIC_PROMPTPAY_ENABLED": "false",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "production": {
      "bun": "1.3.5",
      "environment": "production",
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_REVIEW_MODE": "false",
        "EXPO_PUBLIC_PROMPTPAY_ENABLED": "false",
        "SENTRY_ALLOW_FAILURE": "true",
        "EXPO_PUBLIC_ENV_NAME": "production",
        "EXPO_PUBLIC_API_URL": "https://tirak-backend.tirak-court.workers.dev/api",
        "EXPO_PUBLIC_ENABLE_DEMO_MODE": "false"
      },
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "release-apk": {
      "extends": "production",
      "distribution": "internal",
      "environment": "production",
      "channel": "production",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6748445775"
      }
    }
  }
}
